# Do not commit your actual .env. Generate it with: java scripts/SetupEnv.java
QUESTION_DB_USERNAME=question_app
QUESTION_DB_PASSWORD=
QUIZ_DB_USERNAME=quiz_app
QUIZ_DB_PASSWORD=

# Optional legacy operator account. Website signup does not need these.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Base64 DER RSA keys; generate with java scripts/SetupEnv.java --keys-only
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY=
# Local HTTP demo only. Use true and HTTPS when hosted.
COOKIE_SECURE=false
PUBLIC_APP_URL=http://localhost:8765
ACCOUNT_REQUIRE_VERIFICATION=false
ACCOUNT_MAIL_ENABLED=false
# Optional email delivery: configure an external SMTP provider when enabling email.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@quiz.local
